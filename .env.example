NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://eventpulse:eventpulse@localhost:5432/eventpulse?schema=public
# Required in production. The login must inherit from the eventpulse_app group role,
# which has no UPDATE/DELETE privilege on check_ins, refunds and audit_logs.
# DATABASE_RUNTIME_URL=postgresql://eventpulse_runtime:CHANGE_ME@localhost:5432/eventpulse?schema=public
# Integer between 1 and 100. PostgreSQL max_connections defaults to 100.
DATABASE_POOL_SIZE=10

# Dedicated database for PostgreSQL integrity tests. Its name must end with _test
# and must not contain prod/production/staging. Remote hosts are refused unless
# ALLOW_REMOTE_TEST_DATABASE=true is set explicitly for an isolated server.
TEST_DATABASE_URL=postgresql://eventpulse:eventpulse@localhost:5432/eventpulse_test?schema=public
# ALLOW_REMOTE_TEST_DATABASE=false
# Optional: name of a real runtime login role to validate in privileges.test.ts.
# The role must inherit from the eventpulse_app group. Leave unset locally.
# TEST_RUNTIME_LOGIN_ROLE=eventpulse_runtime

# Dedicated Redis for real Lua/atomic rate-limit tests. Start it with:
#   docker compose up -d redis-test
# Then run integration tests with TEST_REDIS_URL=redis://localhost:6380/15.
# Do not point this at a production Redis.
# TEST_REDIS_URL=redis://localhost:6380/15
REDIS_TEST_PORT=6380

POSTGRES_DB=eventpulse
POSTGRES_USER=eventpulse
POSTGRES_PASSWORD=eventpulse
POSTGRES_PORT=5432

# --- Authentication & Identity (Phase 4A.4) --------------------------------
# All secrets below are REQUIRED in production and must be at least 32 chars.
# Development/test fall back to insecure defaults that are rejected in production.
# JWT_ACCESS_SECRET=CHANGE_ME_32+_RANDOM_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=eventpulse-analytics
JWT_AUDIENCE=eventpulse-api
JWT_KEY_ID=primary
# REFRESH_TOKEN_PEPPER=CHANGE_ME_32+_RANDOM_CHARACTERS
# PASSWORD_RESET_TOKEN_PEPPER=CHANGE_ME_32+_RANDOM_CHARACTERS

# Sliding window vs. hard cap. Effective expiry is MIN(now + sliding, absolute).
REFRESH_SLIDING_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800

# Secure defaults to true in production; SameSite=Strict, HttpOnly and
# Path=/api/v1/auth are always enforced by the application.
# AUTH_COOKIE_SECURE=true
# Optional cookie domain; must be a valid DNS domain, leading dot allowed.
# AUTH_COOKIE_DOMAIN=

# Comma-separated exact origins. Wildcards are refused because credentials are
# enabled. In production at least one origin is required.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Never use "true"; set the exact number of trusted proxy hops in front of the API.
TRUST_PROXY_HOPS=0

# Required in production: rate limiting and account lockout fail closed without
# a durable Redis instance.
# REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=eventpulse

AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_FORGOT_MAX_ATTEMPTS=5
AUTH_FORGOT_WINDOW_SECONDS=3600
AUTH_REFRESH_MAX_ATTEMPTS=60
AUTH_REFRESH_WINDOW_SECONDS=3600
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_SECONDS=60
AUTH_LOCKOUT_MAX_SECONDS=86400
# Forced to true in production.
AUTH_RATE_LIMIT_FAIL_CLOSED=true
