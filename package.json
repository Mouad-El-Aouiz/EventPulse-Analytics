{
  "name": "eventpulse-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EventPulse Analytics — B2B event management and analytics platform",
  "scripts": {
    "lint": "npm run lint --workspace @eventpulse/api",
    "lint:fix": "npm run lint:fix --workspace @eventpulse/api",
    "format": "npm run format --workspace @eventpulse/api",
    "format:check": "npm run format:check --workspace @eventpulse/api",
    "typecheck": "npm run typecheck --workspace @eventpulse/api",
    "build": "npm run build --workspace @eventpulse/api",
    "start": "npm run start --workspace @eventpulse/api",
    "test": "npm run test --workspace @eventpulse/api",
    "test:watch": "npm run test:watch --workspace @eventpulse/api",
    "test:coverage": "npm run test:coverage --workspace @eventpulse/api"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
