{
  "name": "eventpulse-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EventPulse Analytics — B2B event management and analytics platform",
  "scripts": {
    "lint": "npm run lint --workspace @eventpulse/api",
    "lint:fix": "npm run lint:fix --workspace @eventpulse/api",
    "format": "npm run format --workspace @eventpulse/api",
    "format:check": "npm run format:check --workspace @eventpulse/api",
    "typecheck": "npm run typecheck --workspace @eventpulse/api",
    "build": "npm run build --workspace @eventpulse/api",
    "start": "npm run start --workspace @eventpulse/api",
    "test": "npm run test --workspace @eventpulse/api",
    "test:watch": "npm run test:watch --workspace @eventpulse/api",
    "test:coverage": "npm run test:coverage --workspace @eventpulse/api",
    "test:integration": "npm run test:integration --workspace @eventpulse/api",
    "test:integration:watch": "npm run test:integration:watch --workspace @eventpulse/api",
    "prisma:generate": "npm run prisma:generate --workspace @eventpulse/api",
    "prisma:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:migrate:deploy": "npm run db:check:migrations && prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema apps/api/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:check": "npm run db:check --workspace @eventpulse/api",
    "db:verify:integrity": "npm run db:verify:integrity --workspace @eventpulse/api",
    "db:check:migrations": "npm run db:check:migrations --workspace @eventpulse/api"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
